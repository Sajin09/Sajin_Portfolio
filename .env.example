# EmailJS Configuration
# Get these values from your EmailJS Dashboard: https://dashboard.emailjs.com/admin

# 1. Email Services -> Service ID (e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=

# 2. Email Templates -> Template ID (e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=

# 3. Account -> API Keys -> Public Key (e.g. xxxxxxxxxxxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=
